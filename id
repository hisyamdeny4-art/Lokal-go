/* dashboard live */
const LI=[['Cabai rawit',62000,55000],['Cabai merah keriting',45000,41000],['Tomat',12000,10500],['Bawang merah',38000,35000],['Bawang putih',36000,34500],['Kentang',17000,15500]].map(x=>({n:x[0],f:x[1],m:x[2],b:x[1],h:Array.from({length:12},()=>x[1]*(1+(Math.random()-.5)*.06))}));
function lspark(h){const mn=Math.min(...h),mx=Math.max(...h),r=(mx-mn)||1;return '<svg viewBox="0 0 90 28" class="w-[90px] h-7" aria-hidden="true"><polyline points="'+h.map((v,k)=>(k*90/(h.length-1)).toFixed(1)+','+(26-(v-mn)/r*22).toFixed(1)).join(' ')+'" fill="none" stroke="#16a34a" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>'}
function ldraw(){document.getElementById('lrows').innerHTML=LI.map(i=>{const d=(i.f-i.b)/i.b*100,u=d>=0;return '<tr class="text-[15px]"><td class="py-4 px-2 font-semibold text-slate-900">'+i.n+'</td><td class="py-4 px-2 tabular-nums">'+rp(Math.round(i.f))+'</td><td class="py-4 px-2 tabular-nums">'+rp(Math.round(i.m))+'</td><td class="py-4 px-2"><span class="px-2.5 py-1 rounded-full text-sm font-semibold '+(u?'bg-brand-100 text-brand-700':'bg-orange-100 text-orange-700')+'">'+(u?'▲ ':'▼ ')+Math.abs(d).toFixed(1)+'%</span></td><td class="py-4 px-2">'+lspark(i.h)+'</td></tr>'}).join('')}
ldraw();
setInterval(()=>{LI.forEach(i=>{i.f=Math.max(i.b*.9,Math.min(i.b*1.1,i.f*(1+(Math.random()-.5)*.02)));i.m*=1+(Math.random()-.5)*.01;i.h.push(i.f);i.h.shift()});ldraw()},3000);
let lp=11800;const lb=[['CV Segar Jaya',11800],['Resto Sunda Rasa',11700],['Bu Rina, Cimahi',11500]];
function lbd(){document.getElementById('lbids').innerHTML=lb.slice(0,4).map((b,k)=>'<li class="flex justify-between px-3 py-2 rounded-lg '+(k?'bg-slate-50':'bg-slate-50 text-slate-900 font-semibold ring-2 ring-brand-600')+'"><span>'+b[0]+'</span><span>'+rp(b[1])+'</span></li>').join('');document.getElementById('lnow').textContent=rp(lp)}
lbd();
document.getElementById('lbtn').onclick=()=>{lp+=100;lb.unshift(['Anda',lp]);lbd()};
const lend=Date.now()+(2*3600+14*60+30)*1000;
function ltick(){const s=Math.max(0,Math.floor((lend-Date.now())/1000)),p=x=>String(x).padStart(2,'0');document.getElementById('l-h').textContent=p(Math.floor(s/3600));document.getElementById('l-m').textContent=p(Math.floor(s%3600/60));document.getElementById('l-s').textContent=p(s%60)}
ltick();setInterval(ltick,1000);
/* bar dampak */
(function(){const sh=document.getElementById('share'),f=()=>sh.querySelectorAll('[data-w]').forEach(e=>e.style.width=e.dataset.w+'%');'IntersectionObserver' in window?new IntersectionObserver((en,o)=>{if(en[0].isIntersecting){f();o.disconnect()}},{threshold:.4}).observe(sh):f()})();
/* tab gabung */
const JC={F:[['Pasang produk dan tentukan harga sendiri','Ikut lelang untuk panen partai besar','Pantau harga pasar sebelum menjual'],'Daftar sebagai petani'],B:[['Beli sayur segar langsung dari kebun','Ikut lelang untuk kebutuhan grosir','Bandingkan harga dengan pasar hari ini'],'Daftar sebagai pembeli']};
function jtab(k){document.getElementById('jF').className='px-6 py-2.5 rounded-full font-semibold '+(k==='F'?'bg-white text-brand-800':'');document.getElementById('jB').className='px-6 py-2.5 rounded-full font-semibold '+(k==='B'?'bg-white text-brand-800':'');document.getElementById('jF').setAttribute('aria-selected',k==='F');document.getElementById('jB').setAttribute('aria-selected',k==='B');document.getElementById('jpts').innerHTML=JC[k][0].map(t=>'<li>'+t+'</li>').join('');document.getElementById('jcta').textContent=JC[k][1]}
document.getElementById('jF').onclick=()=>jtab('F');document.getElementById('jB').onclick=()=>jtab('B');jtab('F');

icons();
const $=id=>document.getElementById(id);
$('mbtn').onclick=()=>$('mmenu').classList.toggle('hidden');
$('mmenu').addEventListener('click',e=>{if(e.target.tagName==='A')$('mmenu').classList.add('hidden')});
function toast(t){const e=$('toast');e.textContent=t;e.classList.remove('hidden');clearTimeout(toast.k);toast.k=setTimeout(()=>e.classList.add('hidden'),3200)}
function openM(id){$(id).classList.remove('hidden');$(id).classList.add('flex')}
function closeM(id){$(id).classList.add('hidden');$(id).classList.remove('flex')}
function openBuy(i){const p=PR[i];$('m-title').textContent=p.n;$('m-price').textContent=rp(p.p)+' / kg';$('m-farmer').innerHTML='Petani: '+p.f+' ('+p.loc.split(',')[0]+')';$('m-img').src=IMG[i];openM('bm')}
function confirmOrder(){closeM('bm');toast('Pesanan berhasil dibuat! Langsung terhubung dengan petani.')}
let cur=null;
function openBid(i){cur=i;$('b-title').textContent=AU[i].t+' ('+AU[i].v+')';$('b-cur').textContent=rp(AU[i].h)+' / kg';$('b-err').classList.add('hidden');$('b-in').value='';openM('bd')}
function submitBid(){const v=parseInt($('b-in').value,10),er=$('b-err');if(!v||v<=AU[cur].h){er.textContent='Masukkan penawaran yang lebih tinggi dari '+rp(AU[cur].h)+' / kg.';er.classList.remove('hidden');return}AU[cur].h=v;$('hb'+cur).textContent=rp(v)+' / kg';closeM('bd');toast('Penawaran Anda '+rp(v)+' / kg berhasil diajukan!')}
$('nlbtn').onclick=()=>{const m=$('nlmail');if(/^\S+@\S+\.\S+$/.test(m.value)){toast('Terima kasih! Kabar panen akan dikirim ke email Anda.');m.value=''}else toast('Masukkan alamat email yang valid.')};
document.addEventListener('keydown',e=>{if(e.key==='Escape'){closeM('bm');closeM('bd')}});
</script>
